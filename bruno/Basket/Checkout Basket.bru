meta {
  name: Checkout Basket
  type: http
  seq: 5
}

post {
  url: {{base_url}}/basket/checkout
  body: json
  auth: inherit
}

body:json {
  {
    "billingAddress": {
      "firstName": "John",
      "lastName": "Doe",
      "emailAddress": "john.doe@example.com",
      "addressLine": "1 Billing Street",
      "country": "USA",
      "state": "Billing State",
      "zipCode": "10001"
    },
    "payment": {
      "paymentMethodId": "pm_card_visa"
    },
    "shippingAddress": {
      "firstName": "Jane",
      "lastName": "Roe",
      "emailAddress": "jane.roe@example.com",
      "addressLine": "2 Shipping Avenue",
      "country": "USA",
      "state": "Shipping State",
      "zipCode": "90210"
    }
  }
}

assert {
  res.status: eq 202
}

docs {
  Checks out the basket and charges it through the payment provider.

  `payment.paymentMethodId` is a token from the provider, never card details. In a browser, Stripe's card field (Elements) creates it; here it is one of Stripe's test payment method ids, answered by the `payment-provider` WireMock service:

  - `pm_card_visa`: succeeds, card summary `visa` / `4242`
  - `pm_card_mastercard`: succeeds, card summary `mastercard` / `4444`

  For a decline, see *Checkout Basket (Declined)*.
}
